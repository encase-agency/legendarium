# Include within the site's existing server block after configuring its root.
# Review against the real host; this file has not been applied to a server.
location /media/videos/ {
    try_files $uri =404;
    # Nginx static files support Range/206 by default. Do not gzip MP4.
    types { video/mp4 mp4; application/json json; }
}

error_page 403 /403.html;
error_page 404 /404.html;
error_page 500 502 503 504 /500.html;
location = /403.html { internal; }
location = /404.html { internal; }
location = /500.html { internal; }
