# Public build-time configuration. Never put API keys, passwords or tokens in VITE_*.
# Copy to .env.local, fill approved values, then restart/rebuild.
VITE_LEAD_ENDPOINT=
VITE_GETCOURSE_LEGEND_URL=
VITE_GETCOURSE_BASIC_URL=
# Optional HTTPS or root-relative directory; prepared filenames come from preparedVideos.ts.
VITE_MEDIA_BASE_URL=
VITE_CONTACT_LOCATION=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_TELEGRAM_URL=
VITE_TELEGRAM_DIRECT_URL=
VITE_ANDREW_CONTACT_URL=
VITE_INSTAGRAM_URL=
VITE_WHATSAPP_URL=
VITE_YOUTUBE_URL=
VITE_PRIVACY_URL=
VITE_PERSONAL_DATA_URL=
VITE_OFFER_URL=
VITE_TERMS_URL=
VITE_COOKIES_URL=
VITE_LICENSE_TEXT=
VITE_LICENSE_URL=
# GA4 measurement ID G-... and numeric Yandex counter ID.
VITE_GA_ID=
VITE_YANDEX_ID=
